-- | THE ROW A LEDGER READER REBUILDS, not one typed out here.
--
-- This is what `rowsFromTransactions` produces from the synthetic settled cycle
-- the conformance manifest carries (`syn-settle-1`): a `GameStake` created by
-- `Entitlement_Commit` and closed by `GameStake_Settle` with the constructor
-- `ReturnedInFull` in its choice argument. The reader's job on that field is
-- exactly `dispositionTag` — and until this row existed, nothing measured it,
-- because every other row in the suite was written down with its tag already
-- resolved.
--
-- The party is the real TestNet validator id, fingerprint included, because a
-- reader that truncates a party at the `::` produces a leaf that differs from
-- the ledger in one field and is otherwise perfect.
readerSettleRow : CycleAuditRow
readerSettleRow = CycleAuditRow with
  cycleId = "syn-settle-1"
  player = fromSome (partyFromText "arccade-validator-1::1220ce19f2a2928e5775dbc18e14d37c1fa4d8e5579d6234c3def66438a182e963bf")
  gameCode = "trade-wars-v4"
  concurrencyIndex = 0
  entryDigest = "5669632b0fecad52d4c7e31afffb710e13f97b7b2b7c5f2606f5d4c84c594852"
  outcomeDigest = "124de70ecc959cfe2d9f01362a414e9a493df2e10b521551ffd262c1f29d2f0a"
  committedUnits = 1000000000000
  feeUnits = 5000000000
  returnedUnits = 1000000000000
  forfeitedUnits = 0
  payoutUnits = 0
  disposition = ReturnedInFull
  committedAtMicros = 1787437747372202
  settledAtMicros = 1787437775189712
  custodyTag = "arccade-game-sdk:1:syn-settle-1:5669632b0fecad52d4c7e31afffb710e13f97b7b2b7c5f2606f5d4c84c594852"

-- | The leaf of that row. The manifest hands the row the CLIENT rebuilt to the
-- leaf builder and measures the document against this literal, so the reader's
-- tag table is inside the bytes being compared rather than inside the
-- expectation being written.
vectorsReaderRebuiltRow : Script ()
vectorsReaderRebuiltRow = script do
  -- @vector period-leaf-of-a-reader-rebuilt-row
  periodLeaf readerSettleRow === "49ad75762e43b5417e5b0407bbe8255ee5f4c80d1caaa1aa9ff1f3661e9d1077"
  -- @vector period-leaf-of-a-reader-rebuilt-row.text
  periodLeafDocument readerSettleRow
