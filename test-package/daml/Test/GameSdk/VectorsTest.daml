-- | Folding and verifying a proof, including the three ways a forged proof
-- has to fail and the single-leaf trap that makes bare merkleVerify
-- unsafe as an auditor API.
vectorsMerkleVerification : Script ()
vectorsMerkleVerification = script do
  -- @vector merkle-proof-index-out-of-range
  showSteps (merkleProof 5 [leafN 1, leafN 2]) === ""
  -- @vector merkle-verify-promoted-leaf-n3-index-2
  merkleVerify (leafN 3) (merkleProof 2 [leafN 1, leafN 2, leafN 3]) (merkleRoot [leafN 1, leafN 2, leafN 3])
    === True
  -- @vector merkle-verify-promoted-leaf-n5-index-4
  merkleVerify (leafN 5) (merkleProof 4 [leafN 1, leafN 2, leafN 3, leafN 4, leafN 5]) (merkleRoot [leafN 1, leafN 2, leafN 3, leafN 4, leafN 5])
    === True
  -- @vector merkle-verify-promoted-leaf-n9-index-8
  merkleVerify (leafN 9) (merkleProof 8 [leafN 1, leafN 2, leafN 3, leafN 4, leafN 5, leafN 6, leafN 7, leafN 8, leafN 9]) (merkleRoot [leafN 1, leafN 2, leafN 3, leafN 4, leafN 5, leafN 6, leafN 7, leafN 8, leafN 9])
    === True
  -- @vector merkle-verify-empty-proof-single-leaf-trap
  merkleVerify (leafN 1) [] (merkleRoot [leafN 1]) === True
  -- @vector merkle-verify-wrong-leaf-fails
  merkleVerify (leafN 4) (merkleProof 0 [leafN 1, leafN 2, leafN 3]) (merkleRoot [leafN 1, leafN 2, leafN 3])
    === False
  -- @vector merkle-verify-tampered-sibling-fails
  merkleVerify (leafN 0) (map (\s -> s with sibling = leafN 9) (merkleProof 0 [leafN 1, leafN 2, leafN 3])) (merkleRoot [leafN 1, leafN 2, leafN 3])
    === False
  -- @vector merkle-verify-flipped-side-fails
  merkleVerify (leafN 1) (map (\s -> s with siblingOnLeft = not s.siblingOnLeft) (merkleProof 0 [leafN 1, leafN 2, leafN 3])) (merkleRoot [leafN 1, leafN 2, leafN 3])
    === False
  -- @vector merkle-fold-is-separable-from-verify
  merkleFold (leafN 1) (merkleProof 0 [leafN 1, leafN 2, leafN 3])
    === "f31cc766e62a52c3c3156e05d53fde76f54fed6067d283dc9a3d8ada9d0ceedf"

-- | The wire constants and the custody tag, which is a plain concatenation
-- and therefore only injective because the cycleId grammar forbids a colon.
vectorsConstants : Script ()
vectorsConstants = script do
  -- @vector constant-scheme-prefix
  schemePrefix === "arccade-sdk-digest-v1"
  -- @vector constant-digest-alg-id
  digestAlgId === "arccade-sdk-digest-v1/sha256"
  -- @vector constant-custody-tag-prefix
  custodyTagPrefix === "arccade-game-sdk:1:"
  -- @vector custody-tag-prefix-constant
  custodyTagPrefix === "arccade-game-sdk:1:"
  -- @vector constant-dry-run-venue-prefix
  dryRunVenuePrefix === "dryrun-"
  -- @vector custody-tag-shape
  custodyTagFor "tw-testnet-1787437747" "5669632b0fecad52d4c7e31afffb710e13f97b7b2b7c5f2606f5d4c84c594852"
    === "arccade-game-sdk:1:tw-testnet-1787437747:5669632b0fecad52d4c7e31afffb710e13f97b7b2b7c5f2606f5d4c84c594852"
  -- @vector custody-tag-fixture-row-0
  custodyTagFor "tw-testnet-1787437747" "5669632b0fecad52d4c7e31afffb710e13f97b7b2b7c5f2606f5d4c84c594852"
    === "arccade-game-sdk:1:tw-testnet-1787437747:5669632b0fecad52d4c7e31afffb710e13f97b7b2b7c5f2606f5d4c84c594852"
  -- @vector custody-tag-fixture-row-1
  custodyTagFor "pr-livetest-20260824" "fd8d8db1d08ba84d3325137b8adf0c7dc7c894e3bd099b36c9464b618f190d4b"
    === "arccade-game-sdk:1:pr-livetest-20260824:fd8d8db1d08ba84d3325137b8adf0c7dc7c894e3bd099b36c9464b618f190d4b"
  -- @vector custody-tag-fixture-row-2
