-- | Ledger time arithmetic. Every division truncates TOWARD ZERO, and
-- secondsBetween truncates each endpoint independently rather than
-- dividing the elapsed micros -- 0.9s to 60.0s is 60 seconds apart, not 59.
vectorsTimeArithmetic : Script ()
vectorsTimeArithmetic = script do
  -- @vector int-divide-negative-truncates-toward-zero
  (-7) / 2 === (-3)
  -- @vector epoch-seconds-negative-truncates-to-zero
  epochSeconds (atMicros (-500000)) === 0
  -- @vector epoch-seconds-exact-second
  epochSeconds (atMicros 1787437747000000) === 1787437747
  -- @vector epoch-seconds-drops-fraction
  epochSeconds (atMicros 1787437747372202) === 1787437747
  -- @vector seconds-between-truncates-each-endpoint
  secondsBetween (atMicros 900000) (atMicros 60000000) === 60
  -- @vector seconds-between-naive-elapsed-would-differ
  secondsBetween (atMicros 900000) (atMicros 60000000) === 60
  -- @vector seconds-between-same-second
  secondsBetween (atMicros 1000001) (atMicros 1999999) === 0
  -- @vector seconds-between-across-a-second-boundary
  secondsBetween (atMicros 1999999) (atMicros 2000000) === 1
  -- @vector seconds-between-negative-interval
  secondsBetween (atMicros 60000000) (atMicros 900000) === (-60)
  -- @vector add-seconds-cooldown
  epochMicros (addSeconds (atMicros 1787437775189712) 30) === 1787437805189712
  -- @vector add-seconds-zero
  epochMicros (addSeconds (atMicros 1787437775189712) 0) === 1787437775189712
  -- @vector add-seconds-negative
  epochMicros (addSeconds (atMicros 1787437775189712) (-30)) === 1787437745189712

