-- | Yasam dongusu testleri: iki yazmalik dongu, slot kisiti, cooldown,
-- custody kaniti, digest zorlamasi ve oyuncunun koşulsuz cikis yolu.
module Test.GameSdk.LifecycleTest where

import DA.Assert ((===))
import DA.List (sort)
import DA.Time (seconds)
import Daml.Script

import Splice.Api.Token.HoldingV1 qualified as Holding
import Splice.Api.Token.MetadataV1 qualified as Metadata

import ArCCade.GameSdk.Cycle
import ArCCade.GameSdk.Digest (textDigest)
import ArCCade.GameSdk.Time
import ArCCade.GameSdk.Types

import Test.GameSdk.Fixture
import Test.GameSdk.Mocks

-- | Kilitli holding mock'unu, sartlarla TUTARLI olacak sekilde yaratir.
mkLock : Parties -> StakeTerms -> Script (ContractId Holding.Holding)
mkLock p terms = do
  cid <- submitMulti [p.registry, p.player, p.venue] [] do
    createCmd MockLockedHolding with
      registry = p.registry
      owner = p.player
      lockHolders = terms.lockHolders
      instrumentId = terms.instrumentId
      amount = terms.stakeAmount
      expiresAt = Some terms.lockExpiresAt
      context = Some terms.custodyTag
  pure (toInterfaceContractId @Holding.Holding cid)

-- | Tam dongu: commit -> (sure gecer) -> settle. Slot geri gelir, sayaclar artar.
fullCycle : Script ()
fullCycle = script do
  p <- allocParties
  venueCid <- mkVenueWithRoster p ModeLive testPolicy
  entCid <- mkEntitlement p venueCid

  now <- getTime
  let cycleId = "tw-0001"
  let terms = mkTerms p cycleId sampleEntryDigest now 3600 100.0 0.5
  lockCid <- mkLock p terms

  stakeCid <- submitMulti [p.operator, p.player] [] do
    exerciseCmd entCid Entitlement_Commit with
      gameCode = "trade-wars-v4"
      cycleId
      terms
      entryDigest = sampleEntryDigest
      stakeMeta = Metadata.emptyMetadata

  -- Asgari dongu suresi dolsun.
  passTime (seconds 15)

  let outcomeDoc = "outcome-document-v1"
  newEntCid <- submitMulti [p.operator, p.venue, p.player] [] do
    exerciseCmd stakeCid GameStake_Settle with
      disposition = ReturnedInFull
      returnedAmount = 100.0
      forfeitedAmount = 0.0
      payoutAmount = 0.0
      outcomeDigest = textDigest outcomeDoc
      revealedOutcome = Some outcomeDoc
      revealedEntry = None
      custodyRef = Some (HoldingRef lockCid)
      settlementMeta = Metadata.emptyMetadata

  ent <- queryContractId p.operator newEntCid
  case ent of
    Some e -> do
      assertMsg "dongu sayaci artmali" (e.cyclesCompleted == 1)
      assertMsg "toplam stake artmali" (e.lifetimeStaked == 100.0)
      assertMsg "cooldown ileri alinmali" (e.nextEligibleAt > now)
    None -> abort "geri verilen entitlement bulunamadi"

-- | Bir entitlement TEK KULLANIMLIKTIR: commit onu arsivler, ikinci commit
-- ledger tarafindan reddedilir.
--
-- ADI ONEMLI. Bu test es zamanliligi KANITLAMAZ ve bir sure "concurrencyEnforced"
-- adini tasidi; o ad, kanitlanmamis bir garantinin kanitlanmis gorunmesine yol
-- acti. GameVenue_IssueEntitlements yalnizca `0 <= concurrencyIndex <
-- concurrencyLimit` araligini denetler: tutulan entitlement SAYISINA ve
-- indekslerin BENZERSIZLIGINE bakmaz. Yani venue ayni indeksle sinirsiz slot
-- basabilir ve her biri burada oldugu gibi tek kullanimlik olur; toplam acik
-- dongu sayisi yine sinirsizdir.
--
-- Gercek es zamanlilik siniri 1.4.0'da pakete girecek. O gune kadar sinir
-- servis katmanindadir ve zincir garantisi olarak ANLATILMAMALIDIR.
entitlementIsSingleUse : Script ()
entitlementIsSingleUse = script do
  p <- allocParties
  venueCid <- mkVenueWithRoster p ModeLive testPolicy
  entCid <- mkEntitlement p venueCid
  now <- getTime
  let terms1 = mkTerms p "tw-a" sampleEntryDigest now 3600 100.0 0.5

  _ <- submitMulti [p.operator, p.player] [] do
    exerciseCmd entCid Entitlement_Commit with
      gameCode = "trade-wars-v4"; cycleId = "tw-a"; terms = terms1
      entryDigest = sampleEntryDigest; stakeMeta = Metadata.emptyMetadata

  -- Ikinci commit ayni (artik arsivlenmis) entitlement'i tuketmeye calisir.
  let terms2 = mkTerms p "tw-b" sampleEntryDigest now 3600 100.0 0.5
  submitMultiMustFail [p.operator, p.player] [] do
    exerciseCmd entCid Entitlement_Commit with
      gameCode = "trade-wars-v4"; cycleId = "tw-b"; terms = terms2
      entryDigest = sampleEntryDigest; stakeMeta = Metadata.emptyMetadata

