-- | Ayni oyuncuya ikinci dagitim LEDGER tarafindan reddedilir.
--
-- 1.3.0'da bu gecerdi. Es zamanlilik siniri, oyuncuya tam olarak
-- @concurrencyLimit@ slot verilmesine dayaniyordu ama "tam olarak"i hicbir
-- sey zorlamiyordu: venue ayni oyuncuya istedigi kadar slot basabilir ve
-- kendi politikasini anlamsiz kilabilirdi. Testin adi ile kanitladigi seyin
-- ayni olmasina dikkat: bu test dagitimi olcer, tek kullanimliligi degil.
secondIssuanceRejected : Script ()
secondIssuanceRejected = script do
  p <- allocParties
  venueCid <- mkVenueWithRoster p ModeLive testPolicy
  _ <- submit p.operator do
    exerciseCmd venueCid GameVenue_IssueEntitlements with
      grants = [EntitlementGrant with player = p.player; concurrencyIndex = 0; tier = "silver"]

  -- Dagitim venue'yu tuketip yeniden yaratir; ikinci deneme GUNCEL venue'ya
  -- yapilmali, yoksa arsivlenmis kontrat yuzunden yanlis sebeple gecersiz olur.
  venues <- query @GameVenue p.operator
  case venues of
    [(currentVenue, _)] ->
      submitMustFail p.operator do
        exerciseCmd currentVenue GameVenue_IssueEntitlements with
          grants = [EntitlementGrant with player = p.player; concurrencyIndex = 0; tier = "gold"]
    _ -> abort "tek bir guncel venue bekleniyordu"

-- | Dagitim politikanin izin verdigi kadar slot uretir — ne eksik ne fazla —
-- ve indeksler farklidir.
--
-- Adet artik cagirana birakilmiyor: hangi indekslerin uretilecegine politika
-- karar veriyor, dolayisiyla benzersizlik denetlenen degil YAPISAL bir sey.
issuanceCreatesExactlyTheLimit : Script ()
issuanceCreatesExactlyTheLimit = script do
  p <- allocParties
  let policy = testPolicy with concurrencyLimit = 3
  venueCid <- mkVenueWithRoster p ModeLive policy
  cids <- submit p.operator do
    exerciseCmd venueCid GameVenue_IssueEntitlements with
      grants = [EntitlementGrant with player = p.player; concurrencyIndex = 0; tier = "silver"]
  length cids === 3

  ents <- query @PlayerEntitlement p.player
  let ixs = map (\(_, e) -> e.concurrencyIndex) ents
  sort ixs === [0, 1, 2]

-- | Defteri olmayan bir venue slot DAGITAMAZ.
--
-- Fail-closed bilerek secildi. Roster'i istege bagli yapmak zorlamayi da
-- istege bagli yapardi; 1.3.0'dan yukseltilen venue'lar once
-- @GameVenue_InitRoster@ cagirmak zorunda.
issuanceNeedsRoster : Script ()
issuanceNeedsRoster = script do
  p <- allocParties
  venueCid <- mkVenue p ModeLive testPolicy   -- roster = None
  submitMustFail p.operator do
    exerciseCmd venueCid GameVenue_IssueEntitlements with
      grants = [EntitlementGrant with player = p.player; concurrencyIndex = 0; tier = "silver"]

-- | Defter bir kez kurulur.
--
-- Ikinci kurulum mevcut zinciri bir kenara birakir ve daha once verilmis
-- slotlari GORUNMEZ kilardi — yani zorlamayi tek cagriyla sifirlamanin yolu
-- olurdu.
rosterInitIsOneShot : Script ()
rosterInitIsOneShot = script do
  p <- allocParties
  venueCid <- mkVenue p ModeLive testPolicy
  withRoster <- submit p.operator do
    exerciseCmd venueCid GameVenue_InitRoster with shardCapacity = 8
  submitMustFail p.operator do
    exerciseCmd withRoster GameVenue_InitRoster with shardCapacity = 8

-- | Shard tasmasi zinciri BOZMAZ, ve eski oyuncu hala bulunur.
--
-- Bu, bu tasarimda kolayca yanlis yapilan tek sey icin. Ilk yazimda dagitim
-- kuyruk shard'ini tuketip yeniden yaratiyordu; bu, EBEVEYNININ isaretcisini
-- arsivlenmis bir kontrata cevirir — derlenir, tek shard'la gecer ve ancak
-- ikinci shard acilinca patlar. Simdi buyume BASTAN yapiliyor: dolu bas
-- tuketilmez, onu gosteren yeni bir bas yaratilir.
--
-- Kapasite 1 secildi ki ikinci oyuncu tasmayi ZORLASIN.
shardRolloverKeepsChainIntact : Script ()
shardRolloverKeepsChainIntact = script do
  p <- allocParties
  venueCid <- mkVenue p ModeLive testPolicy
  v0 <- submit p.operator do
    exerciseCmd venueCid GameVenue_InitRoster with shardCapacity = 1

  _ <- submit p.operator do
    exerciseCmd v0 GameVenue_IssueEntitlements with
      grants = [EntitlementGrant with player = p.player; concurrencyIndex = 0; tier = "silver"]
  venues1 <- query @GameVenue p.operator
  currentVenue <- case venues1 of
    [(cid, _)] -> pure cid
    _ -> abort "tek guncel venue bekleniyordu"

  -- Ikinci oyuncu basi tasirir: yeni bas, eskisini gosterir.
  _ <- submit p.operator do
    exerciseCmd currentVenue GameVenue_IssueEntitlements with
      grants = [EntitlementGrant with player = p.operator; concurrencyIndex = 0; tier = "gold"]

  -- Zincir saglamsa ILK oyuncu hala bulunur — yani yurumek eski shard'a
  -- ulasabiliyor ve onun kontrat id'si canli.
  venues2 <- query @GameVenue p.operator
  case venues2 of
    [(cid, v)] -> case v.roster of
      Some headCid -> do
        found <- submit p.operator do
          exerciseCmd headCid Roster_Contains with who = p.player
        found === True
        -- Ve ayni oyuncuya ucuncu bir dagitim hala reddedilir.
        submitMustFail p.operator do
          exerciseCmd cid GameVenue_IssueEntitlements with
            grants = [EntitlementGrant with player = p.player; concurrencyIndex = 0; tier = "gold"]
      None -> abort "roster kurulmus olmaliydi"
    _ -> abort "tek guncel venue bekleniyordu"
