-- | Kilit suresi dolduktan sonra oyuncu TEK BASINA cikabilir.
-- arCCade'in oyuncunun slotunu mahsur birakabilecegi bir durum yoktur.
playerSelfRecovery : Script ()
playerSelfRecovery = script do
  p <- allocParties
  venueCid <- mkVenue p ModeLive testPolicy
  entCid <- mkEntitlement p venueCid
  now <- getTime
  let terms = mkTerms p "tw-g" sampleEntryDigest now 60 100.0 0.5
  stakeCid <- submitMulti [p.operator, p.player] [] do
    exerciseCmd entCid Entitlement_Commit with
      gameCode = "trade-wars-v4"; cycleId = "tw-g"; terms
      entryDigest = sampleEntryDigest; stakeMeta = Metadata.emptyMetadata

  -- Sure dolmadan cikis reddedilir.
  submitMustFail p.player do exerciseCmd stakeCid GameStake_ExpireUnsettled

  passTime (seconds 61)
  newEntCid <- submit p.player do exerciseCmd stakeCid GameStake_ExpireUnsettled
  ent <- queryContractId p.player newEntCid
  case ent of
    Some e -> assertMsg "sure asimi dongu sayilmaz" (e.cyclesCompleted == 0)
    None -> abort "entitlement geri gelmedi"

-- | Kuru kosum kipi: custody kaniti olmadan tum dongu calisir.
-- TestNet'te cuzdanda 0 CC varken SDK'nin ucdan uca gosterilebilmesini saglar.
dryRunNeedsNoCustody : Script ()
dryRunNeedsNoCustody = script do
  p <- allocParties
  let dryPolicy = dryRunPolicy
  venueCid <- mkVenue p ModeDryRun dryPolicy
  entCid <- mkEntitlement p venueCid
  now <- getTime
  let terms = mkTerms p "dry-1" sampleEntryDigest now 3600 100.0 0.01
  stakeCid <- submitMulti [p.operator, p.player] [] do
    exerciseCmd entCid Entitlement_Commit with
      gameCode = "trade-wars-v4"; cycleId = "dry-1"; terms
      entryDigest = sampleEntryDigest; stakeMeta = Metadata.emptyMetadata
  passTime (seconds 15)
  newEntCid <- submit p.operator do
    exerciseCmd stakeCid GameStake_Settle with
      disposition = ReturnedInFull; returnedAmount = 100.0; forfeitedAmount = 0.0
      payoutAmount = 0.0; outcomeDigest = textDigest "dry"
      revealedOutcome = None; revealedEntry = None
      custodyRef = None
      settlementMeta = Metadata.emptyMetadata
  ent <- queryContractId p.operator newEntCid
  case ent of
    Some e -> assertMsg "kuru kosum dongusu de sayilir (raporlamada ayri sinifta)" (e.cyclesCompleted == 1)
    None -> abort "entitlement geri gelmedi"

-- | Zaman kilitli stake settlement icinde musadere EDILEMEZ.
timeLockedForfeitRejected : Script ()
timeLockedForfeitRejected = script do
  p <- allocParties
  venueCid <- mkVenue p ModeLive testPolicy
  entCid <- mkEntitlement p venueCid
  now <- getTime
  let terms = mkTerms p "tw-h" sampleEntryDigest now 3600 100.0 0.5
  lockCid <- mkLock p terms
  stakeCid <- submitMulti [p.operator, p.player] [] do
    exerciseCmd entCid Entitlement_Commit with
      gameCode = "trade-wars-v4"; cycleId = "tw-h"; terms
      entryDigest = sampleEntryDigest; stakeMeta = Metadata.emptyMetadata
  passTime (seconds 15)
  submitMultiMustFail [p.operator, p.venue, p.player] [] do
    exerciseCmd stakeCid GameStake_Settle with
      disposition = ReturnedWithForfeit
      returnedAmount = 60.0
      forfeitedAmount = 40.0     -- toplami dogru ama TimeLockedHolding'de yasak
      payoutAmount = 0.0; outcomeDigest = textDigest "x"
      revealedOutcome = None; revealedEntry = None
      custodyRef = Some (HoldingRef lockCid)
      settlementMeta = Metadata.emptyMetadata

