      settlementMeta = Metadata.emptyMetadata

-- | Kilit YANLIS etiketi tasiyorsa settlement reddedilir.
-- Bu, "venue yanlis etiket yazarsa o stake'i kullanilamaz hale getirir"
-- ozelliginin testidir.
custodyTagMismatch : Script ()
custodyTagMismatch = script do
  p <- allocParties
  venueCid <- mkVenueWithRoster p ModeLive testPolicy
  entCid <- mkEntitlement p venueCid
  now <- getTime
  let terms = mkTerms p "tw-d" sampleEntryDigest now 3600 100.0 0.5
  -- Kilit BASKA bir dongunun etiketiyle yaratiliyor.
  let wrongTerms = terms with custodyTag = custodyTagFor "tw-BASKA" sampleEntryDigest
  lockCid <- mkLock p wrongTerms

  stakeCid <- submitMulti [p.operator, p.player] [] do
    exerciseCmd entCid Entitlement_Commit with
      gameCode = "trade-wars-v4"; cycleId = "tw-d"; terms
      entryDigest = sampleEntryDigest; stakeMeta = Metadata.emptyMetadata
  passTime (seconds 15)
  submitMultiMustFail [p.operator, p.venue, p.player] [] do
    exerciseCmd stakeCid GameStake_Settle with
      disposition = ReturnedInFull; returnedAmount = 100.0; forfeitedAmount = 0.0
      payoutAmount = 0.0; outcomeDigest = textDigest "x"
      revealedOutcome = None; revealedEntry = None
      custodyRef = Some (HoldingRef lockCid)
      settlementMeta = Metadata.emptyMetadata

