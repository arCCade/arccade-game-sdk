<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.arccade</groupId>
  <artifactId>game-sdk</artifactId>
  <version>1.6.0</version>
  <packaging>jar</packaging>

  <name>arCCade Game SDK (Java)</name>
  <description>
    The Java implementation of the arccade-sdk-digest-v1 commitment scheme, the
    period-anchor Merkle tree, and the audit-row reconstruction that turns a
    ledger transaction stream into a verifiable period report. Byte-for-byte
    identical to the Daml, JavaScript and Python implementations in this
    repository; conformance/manifest.json is the shared contract.
  </description>
  <url>https://github.com/arccade/arccade-game-sdk</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!--
    REQUIRED BY MAVEN CENTRAL, not decoration. Its validator rejects a POM with
    no <developers> and no <scm>, and it rejects it at upload — after the
    signing, after the staging, at the last step. Both blocks exist so the first
    publish is not the thing that discovers them.
  -->
  <developers>
    <developer>
      <name>arCCade</name>
      <url>https://arccade.io</url>
      <organization>arCCade</organization>
      <organizationUrl>https://arccade.io</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/arccade/arccade-game-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/arccade/arccade-game-sdk.git</developerConnection>
    <url>https://github.com/arccade/arccade-game-sdk</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      Java 17, not 21. The classes use records, so 17 is the floor; going higher
      would exclude Java 17 consumers from an artifact that has no reason to
      need anything newer. The wallet backend this was relocated from builds at
      21 and keeps working, because a 17 artifact runs on 21.
    -->
    <maven.compiler.release>17</maven.compiler.release>

    <junit.version>5.10.5</junit.version>

    <!--
      Plugin versions are pinned rather than inherited. An SDK whose output is a
      commitment digest should not have its build change underneath it because a
      plugin released a new version.
    -->
    <maven-clean-plugin.version>3.3.2</maven-clean-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>

    <!--
      Release-only plugins, pinned for the same reason as the rest: an SDK whose
      output is a commitment digest must not have its build move underneath it.
    -->
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.7.0</central-publishing-maven-plugin.version>
  </properties>

  <dependencies>
    <!--
      NO RUNTIME DEPENDENCIES, deliberately. See io.arccade.gamesdk.Json for the
      argument: the only JSON this artifact reads is a ledger transaction tree,
      through six read-only operations, and making every consumer resolve
      jackson-databind for that is a worse trade than three hundred auditable
      lines of parser. If this list ever grows, that decision is being reversed
      and should be argued for in the same place.
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>${maven-clean-plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>${maven-resources-plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
      </plugin>
    </plugins>
  </build>

  <!--
    PUBLISHING LIVES IN A PROFILE, and is off by default.

    Signing needs a private key. If the gpg plugin sat in the default build,
    every `mvn test` on a laptop and every CI run would need one, and the usual
    escape from that is `-Dgpg.skip=true` — which then rides along into the one
    build where the signature was the point.

    Sources and javadoc jars are here for a smaller reason: they are required by
    Central and they are pure cost on every other build.

      mvn -Prelease deploy
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
            <configuration>
              <!--
                Javadoc's doclint fails a build on a missing @param. This
                artifact documents its INVARIANTS in prose above each class,
                which is where they belong, and a release must not be blocked
                by a tag that adds nothing to a digest implementation.
              -->
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- No TTY in CI: the passphrase arrives as a property. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!--
                MANUAL, not automatic. The first publish of a namespace is the
                one that cannot be undone: Central has no delete. A staged
                deployment can be inspected and dropped; an automatic one is
                already public by the time anyone looks.
              -->
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
