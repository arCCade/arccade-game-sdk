# Daml build output and package cache. .daml/dist holds the built DAR, which is
# a build artifact — the vetted package is identified by its hash on the ledger,
# not by a file in the repo.
.daml/
*.dar

# ...but the vendored Splice interface DARs ARE source: they are what makes a
# clone buildable with no setup, and what makes the build reproducible against
# the bytes that were vetted.
!vendor/**/*.dar

node_modules/
.DS_Store
*.log
