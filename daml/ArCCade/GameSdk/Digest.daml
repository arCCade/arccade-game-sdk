-- | Commitment semasi: @arccade-sdk-digest-v1/sha256@.
--
-- Tek mekanizma var, iki degil: bir yuk KANONIK METIN BELGESINE donusturulur
-- ve commitment o metnin sha256'sidir.
--
-- Bu tercih tasiyici:
--
--   (a) Ucuncu taraf, arCCade'in yayinladigi baytlar uzerinde duz @sha256@
--       calistirarak dogrular. Kutuphane yok, yapisal gezinme yok.
--   (b) Pre-image bir @Text@ oldugu icin @GameStake_Settle@ onu choice
--       argumani olarak alip digest'i LEDGER UZERINDE yeniden hesaplayabilir
--       ve uyusmazligi reddeder. Yani commitment kayit altina alinmakla
--       kalmaz, ledger tarafindan ZORLANIR.
--
-- Alan adlari ASCII [a-zA-Z0-9-] olmak zorundadir; siralama boylece diller
-- arasi belirsizlige dusmez. Alanlar ADA GORE SIRALANIR, dolayisiyla alan
-- sirasi belgenin parcasi degildir ve sonraki bir surumde eklenen alan v1
-- digest'ini sessizce degistiremez. Her belge kendi semasini ve surumunu
-- tasir; iki farkli yuk turu alanlari cakissa bile ayni digest'i uretmez.
module ArCCade.GameSdk.Digest where

import DA.Crypto.Text (sha256, toHex)
import DA.List (sortOn, (!!))
import DA.Text qualified as T

import ArCCade.GameSdk.Time (epochMicros)

-- | Sema kimligi. Digest'in ilk bileseni; surum atlamalarinda degisir.
schemePrefix : Text
schemePrefix = "arccade-sdk-digest-v1"

-- | Genel kodlama: @\<tag\>:\<uzunluk\>:\<deger\>@.
--
-- Uzunluk UNICODE KOD NOKTASI cinsindendir (Daml @DA.Text.length@;
-- Python @len(str)@; Java __codePointCount__ kullanmak ZORUNDA, UTF-16
-- birimi sayan @String.length@ degil).
--
-- Uzunluk oneki kodlamayi injektif yapar: icerik ayraclari taklit edemez.
canon : Text -> Text -> Text
canon tag value = tag <> ":" <> show (T.length value) <> ":" <> value

canonText : Text -> Text
canonText = canon "t"

canonInt : Int -> Text
canonInt i = canon "i" (show i)

-- | Tutarlar ASLA islenmis @Decimal@ olarak hash'lenmez — Decimal
-- bicimlendirmesi baska bir dilin tesadufen eslestigi kanonik bir bicim
-- degildir. Tamsayi 1e-10 birimine cevrilir.
canonDecimal : Decimal -> Text
canonDecimal d = canon "d" (show (amountUnits d))

canonBool : Bool -> Text
canonBool b = canon "b" (if b then "true" else "false")

-- | Zaman her zaman epoch'tan beri TAMSAYI MIKROSANIYE; ISO metni degil.
canonTime : Time -> Text
canonTime t = canon "m" (show (epochMicros t))

-- | Namespace parmak izi dahil tam party kimligi.
canonParty : Party -> Text
canonParty p = canon "p" (partyToText p)

canonOptional : (a -> Text) -> Optional a -> Text
canonOptional _ None = canon "o" ""
canonOptional f (Some x) = canon "o" (f x)

-- | Liste: eleman sayisi da kodlanir, elemanlar @|@ ile birlestirilir.
-- Elemanlar cagiran tarafindan zaten kanonik hale getirilmis olmalidir.
canonList : [Text] -> Text
canonList xs = canon "l" (show (length xs) <> ":" <> T.intercalate "|" xs)

-- | Kayit: alanlar ADA GORE siralanir, her biri @k:...:ad=deger;@ olur.
-- Degerler cagiran tarafindan zaten kanonik hale getirilmis olmalidir.
canonFields : [(Text, Text)] -> Text
canonFields kvs =
  canon "r" (T.implode [ canon "k" k <> "=" <> v <> ";" | (k, v) <- sortOn fst kvs ])

-- | Tam belge: sema oneki + sema adi + sema surumu + siralanmis alanlar.
canonDocument : Text -> Int -> [(Text, Text)] -> Text
canonDocument schema version kvs =
  schemePrefix <> "|" <> canonText schema <> canonInt version <> canonFields kvs

-- | Belgenin commitment'i: kanonik metnin sha256'si (64 karakter, kucuk harf hex).
documentDigest : Text -> Int -> [(Text, Text)] -> Text
documentDigest schema version kvs = textDigest (canonDocument schema version kvs)

-- | Hazir kanonik metnin digest'i. @GameStake_Settle@ bunu, kendisine
-- argumanla verilen pre-image uzerinde calistirip saklanan digest ile
-- karsilastirir.
--
-- DIKKAT — Daml'in @DA.Crypto.Text.sha256@ fonksiyonu rastgele metni DEGIL,
-- bir HEX DIZESINI girdi olarak alir ve o dizenin cozdugu baytlari hash'ler.
-- Dogrudan metin verilirse calisma zamaninda
-- @GeneralError: Message argument is not a hex string@ ile patlar (derleme
-- asamasinda yakalanmaz). Bu yuzden metin once @toHex@ ile UTF-8 baytlarina
-- cevrilir.
--
-- Bunun yan etkisi tam olarak istedigimiz seydir: sonuc, yayinlanan belgenin
-- HAM BAYTLARININ sha256'sidir. Ucuncu taraf dosyaya duz @sha256sum@
-- calistirarak ayni degeri elde eder — Daml'e, bu pakete ya da herhangi bir
-- kutuphaneye ihtiyac duymadan.
-- BOS METIN KABUL ETMEZ. @toHex ""@ bos dize verir ve @sha256@ onu gecerli
-- bir hex dizesi saymaz: sonuc, derlemede yakalanmayan bir calisma zamani
-- @GeneralError@'udur. Kanonik belgeler her zaman sema onekiyle basladigi
-- icin @documentDigest@ bu duruma DUSEMEZ; risk yalnizca ham metni disaridan
-- alan yollardadir ve orada bos girdi cagrilmadan once elenir
-- (bkz. @assertDigestMatches@).
textDigest : Text -> Text
textDigest t = sha256 (toHex t)

-- | Tutar -> tamsayi 1e-10 birimi, gidis-donus guvenligiyle.
--
-- Sessizce hassasiyet kaybetmek ya da tasmak yerine hata verir. Temsil
-- edilebilir bant tam olarak +/-922337203.6854775807 — bir CC stake'i
-- bunun cok altindadir.
--
-- @truncate@ sifira dogru yuvarlar; Java @BigDecimal.setScale(0, DOWN)@ ve
-- JS @BigInt@ ayni davranir, dolayisiyla negatiflerde de mutabakat vardir.
amountUnits : Decimal -> Int
amountUnits d =
  let u = truncate (d * 1e10)
  in if intToDecimal u / 1e10 == d
       then u
       else error ("arccade-sdk-digest-v1: tutar 1e-10 birimine kayipsiz cevrilemedi: " <> show d)

-- ---------------------------------------------------------------------------
-- Merkle
-- ---------------------------------------------------------------------------
--
-- Donem capasinin (@VenuePeriodAnchor@) altindaki yapi. Ruhen
-- @Splice.Amulet.CryptoHash@'ten alinmistir ama ASLA import edilmez: import
-- etmek bir splice-amulet paket kimligini bu pakete civilemek olurdu.
--
-- IKI ALAN AYRIMI ZORUNLUDUR — ama koruma @merkleVerify@'in ICINDE DEGIL.
-- @merkleVerify@ bir hash'i katlar; basladigi degerin yaprak mi ic dugum mu
-- oldugunu bilemez, dolayisiyla bir ic dugum icin de "gecerli" doner. Koruma
-- su noktadadir: bir seyin YAPRAK oldugunu iddia etmek, onun on-imgesini
-- gostermek demektir, ve yaprak on-imgesi @arccade.cycle-audit-row@ semali
-- bir belgedir; ic dugum ise @arccade.merkle-node@ semalidir. Bir ic dugumu
-- satir diye sunmak, iki sema arasinda sha256 cakismasi bulmak demektir.
--
-- Bu yuzden denetcinin kullanmasi gereken uc @merkleVerify@ degil,
-- @Audit.periodRowVerify@'dir: yapragi SATIRDAN kendisi hesaplar, boylece
-- alan ayrimi susleme degil tasiyici olur.
--
-- TEK KALAN DUGUM KOPYALANMAZ, YUKSELTILIR. Bitcoin'in son dugumu
-- kendisiyle esleme yordami, FARKLI yaprak kumelerinin AYNI koku uretmesine
-- izin verir (CVE-2012-2459). Burada tek kalan dugum bir ust seviyeye
-- oldugu gibi tasinir. Ayrica @cycleCount@ capa belgesinin icindedir,
-- dolayisiyla yaprak sayisi da commitment'in parcasidir.

-- | Bos donemin koku. Hic dongu kosmamis bir gun de capalanir: "hicbir sey
-- olmadi" ile "raporlamadik" ancak boyle ayirt edilir.
merkleEmpty : Text
merkleEmpty = documentDigest "arccade.merkle-empty" 1 []

-- | Ic dugum. Yapraklardan AYRI bir sema; bkz. yukaridaki alan ayrimi notu.
merkleNode : Text -> Text -> Text
merkleNode l r =
  documentDigest "arccade.merkle-node" 1 [("l", canonText l), ("r", canonText r)]

-- | Bir seviyeyi ikiserli birlestirir. Tek kalan yukseltilir.
--
-- LF 2.1: yerel ozyinelemeli baglama reddedilir ("recursion can only happen
-- at the top level"), bu yuzden ust seviyededir.
merklePairUp : [Text] -> [Text]
merklePairUp [] = []
merklePairUp [x] = [x]
merklePairUp (a :: b :: rest) = merkleNode a b :: merklePairUp rest

-- | Koke kadar yurur.
merkleWalk : [Text] -> Text
merkleWalk [] = merkleEmpty
merkleWalk [root] = root
merkleWalk xs = merkleWalk (merklePairUp xs)

-- | Yapraklarin koku.
merkleRoot : [Text] -> Text
merkleRoot = merkleWalk

-- | Icerme kanitinin bir adimi: kardes dugum ve hangi tarafta oldugu.
data MerkleStep = MerkleStep
  with
    siblingOnLeft : Bool
    sibling : Text
  deriving (Eq, Show)

-- | Kaniti yaprakdan koke katlar.
merkleFold : Text -> [MerkleStep] -> Text
merkleFold acc [] = acc
merkleFold acc (s :: rest) =
  merkleFold (if s.siblingOnLeft then merkleNode s.sibling acc else merkleNode acc s.sibling) rest

-- | Yaprak bu kokun altinda mi. Denetcinin tek ihtiyaci budur: yayinlanan
-- satir, capalanan koke ait mi.
merkleVerify : Text -> [MerkleStep] -> Text -> Bool
merkleVerify leaf steps root = merkleFold leaf steps == root

-- | @ix@ numarali yaprak icin icerme kaniti uretir.
--
-- Kok yayinlamak ama kanit uretmenin yolunu vermemek ozelligin yarisidir;
-- denetci kaniti kendisi kurmak zorunda kalirsa agac yordamini tahmin eder.
merkleProof : Int -> [Text] -> [MerkleStep]
merkleProof ix leaves =
  if ix < 0 || ix >= length leaves then [] else merkleProofWalk ix leaves

merkleProofWalk : Int -> [Text] -> [MerkleStep]
merkleProofWalk _ [] = []
merkleProofWalk _ [_] = []
merkleProofWalk ix level =
  let sibIx = if ix % 2 == 0 then ix + 1 else ix - 1
      rest = merkleProofWalk (ix / 2) (merklePairUp level)
  in if sibIx >= length level
       -- yukseltilmis dugum: bu seviyede kardesi yok
       then rest
       else (MerkleStep with siblingOnLeft = ix % 2 == 1; sibling = level !! sibIx) :: rest
